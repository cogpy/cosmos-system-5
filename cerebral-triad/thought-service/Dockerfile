# KSM∞ Boundary Restoration — Cerebral-Thought-T7 (port 3001)
# Property restored: 3. Boundaries (Alexander)
# Generated by: /ksm-infinity nn-cycle iteration 1
#
# This per-service Dockerfile replaces the root-level ARG SERVICE_PATH pattern
# with an explicit, locally reasoned deployment boundary. The shared library is
# built first as a workspace dependency.

# ---- Build stage ---------------------------------------------------------
FROM node:18-alpine AS build
WORKDIR /workspace

# Bring in workspace root manifests first to benefit from layer caching
COPY package.json package-lock.json tsconfig.json ./
COPY cognitive-core/shared-libraries ./cognitive-core/shared-libraries

# Bring in only this service
COPY cerebral-triad/thought-service ./cerebral-triad/thought-service

# Install all workspace deps and build the shared lib + this service
RUN npm install --workspaces --include-workspace-root \
 && npm --workspace @cosmos/cognitive-core-shared-libraries run build \
 && npm --workspace cerebral-triad/thought-service run build

# ---- Runtime stage -------------------------------------------------------
FROM node:18-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    SERVICE_NAME=thought-service \
    TRIAD=cerebral \
    SERVICE_TYPE=T-7 \
    POLARITY=sympathetic \
    DIMENSION=2-7

# Copy only the built artefacts (slim runtime)
COPY --from=build /workspace/cognitive-core/shared-libraries/dist \
                  /app/node_modules/@cosmos/cognitive-core-shared-libraries/dist
COPY --from=build /workspace/cognitive-core/shared-libraries/package.json \
                  /app/node_modules/@cosmos/cognitive-core-shared-libraries/package.json
COPY --from=build /workspace/cerebral-triad/thought-service/dist  ./dist
COPY --from=build /workspace/cerebral-triad/thought-service/package.json ./
RUN npm install --omit=dev

# Health check uses the real /health endpoint, not docker default
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:${PORT}/health | grep -q '"status":"healthy"' || exit 1

EXPOSE 3001
USER node
CMD ["node", "dist/index.js"]
